# Copy to .env.local for local work. In Vercel, set these per environment.
# Local dev works with none of them: Turnstile uses Cloudflare's test keys and
# form submissions are printed to the terminal instead of being sent.

# Public site URL (canonical links, sitemap, social image)
NEXT_PUBLIC_SITE_URL=https://example.com

# Cloudflare Turnstile (spam protection on both forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (admin email for every submission). MAIL_FROM must use the verified domain.
RESEND_API_KEY=
MAIL_FROM="FC 2015 Website <web@example.com>"
CLUB_ADMIN_EMAIL=

# Google Sheets lead log (tabs named "Trials" and "Contact"; share the sheet with the service account)
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Daily rebuild (vercel.json cron → /api/rebuild → Deploy Hook)
CRON_SECRET=
DEPLOY_HOOK_URL=

# Tests only: log form submissions instead of sending. Ignored on Vercel production.
# FORMS_DRY_RUN=1
